{
  "cli": {
    "version": ">= 23.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://www.pagealong.com/api",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://www.pagealong.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://www.pagealong.com/api",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://www.pagealong.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
