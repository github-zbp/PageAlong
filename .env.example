POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=15432
POSTGRES_PORT=15432
POSTGRES_DB=web_reader
POSTGRES_USER=web_reader
POSTGRES_PASSWORD=web_reader
DATABASE_URL=postgresql+psycopg://web_reader:web_reader@localhost:15432/web_reader
REDIS_HOST_PORT=16379
REDIS_URL=redis://localhost:16379/0
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
MEDIA_PUBLIC_BASE_URL=
LOCAL_MEDIA_DIR=storage/media

# File upload import. Limits are enforced before queueing and after text normalization.
FILE_IMPORT_MAX_FILE_BYTES=5242880
FILE_IMPORT_MAX_TEXT_CHARACTERS=50000
FILE_IMPORT_STORAGE_BACKEND=local
FILE_IMPORT_LOCAL_DIR=storage/import_uploads
FILE_IMPORT_MAX_FILES_PER_BATCH=100
FILE_IMPORT_DOC_CONVERTER_COMMAND=

# Cloudflare R2 production example. Keep the local MinIO values above for development.
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<r2-access-key>
# S3_SECRET_ACCESS_KEY=<r2-secret-key>
# S3_BUCKET=<bucket-name>
# MEDIA_PUBLIC_BASE_URL=https://media.example.com
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEB_HOST=0.0.0.0
WEB_PORT=3000

# Internal worker/API HMAC protection. Leave secret empty for local development; set in production.
# Use INTERNAL_API_REPLAY_STORE=redis for production multi-instance deployments.
INTERNAL_API_HMAC_SECRET=
INTERNAL_API_SIGNATURE_TTL_SECONDS=300
INTERNAL_API_REPLAY_STORE=memory

# Auth. Keep AUTH_DEV_BYPASS=true for local development while old X-User-Id flows still exist.
AUTH_DEV_BYPASS=true
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_COOLDOWN_SECONDS=60
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_HASH_SECRET=replace-with-random-secret
AUTH_VERIFICATION_STORE_BACKEND=memory
INTERNAL_API_TOKEN=

# Brevo SMTP email verification. Do not commit real SMTP or API keys.
# BREVO_SMTP_USERNAME: Brevo SMTP login, usually the SMTP-specific login shown in Settings > SMTP & API.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
# BREVO_SMTP_PASSWORD: Brevo SMTP key, not your Brevo account password and not an API key.
BREVO_SMTP_PASSWORD=
# MAIL_FROM_EMAIL: a verified sender address in Brevo, ideally on an authenticated domain.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=PageAlong

# Initial admin bootstrap. Set only during init; password is stored as a hash.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# TTS routing. Default auto keeps local/test fake flow unless real providers are explicitly enabled.
TTS_PROVIDER_MODE=auto
TTS_DEFAULT_FREE_PROVIDER=edge_tts
TTS_FREE_FALLBACK_PROVIDER=kokoro_onnx_cpu
TTS_DEFAULT_PAID_PROVIDER=tencent_cloud_tts
TTS_PAID_FALLBACK_PROVIDER=aws_polly_standard
# Temporary MVP entitlement list before auth/payment exists. Comma-separated user IDs use paid TTS routing.
TTS_PAID_USER_IDS=

# Free-tier Edge TTS.
TTS_EDGE_ENABLED=true
TTS_EDGE_TIMEOUT_SECONDS=20
TTS_EDGE_MAX_CONCURRENCY=2

# Free-tier Kokoro ONNX CPU fallback.
TTS_KOKORO_MODEL_PATH=
TTS_KOKORO_VOICES_PATH=
TTS_KOKORO_VOICE=zf_xiaobei
TTS_KOKORO_VOICE_PATH=
TTS_KOKORO_MAX_CONCURRENCY=1

# Paid-tier Tencent Cloud TTS primary provider.
TTS_TENCENT_APP_ID=
TTS_TENCENT_SECRET_ID=
TTS_TENCENT_SECRET_KEY=
TTS_TENCENT_REGION=ap-guangzhou
TTS_TENCENT_VOICE_TYPE=101001
TTS_TENCENT_CODEC=mp3
TTS_TENCENT_SAMPLE_RATE=16000
TTS_TENCENT_TIMEOUT_SECONDS=30
TTS_TENCENT_MAX_CONCURRENCY=16
TTS_TENCENT_MAX_CHINESE_CHARS=560
TTS_TENCENT_MAX_ENGLISH_LETTERS=1600

# Paid-tier AWS Polly Standard fallback. Boto3 also reads standard AWS_* credentials.
TTS_AWS_REGION=us-east-1
TTS_AWS_POLLY_VOICE_ID=Zhiyu
TTS_AWS_POLLY_ENGINE=standard
TTS_AWS_POLLY_MAX_CONCURRENCY=60
TTS_AWS_POLLY_MAX_CHARACTERS=2500
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# TTS quotas and cost controls.
FREE_TTS_MONTHLY_COURSE_LIMIT=3
FREE_TTS_DAILY_COURSE_LIMIT=0
FREE_TTS_MONTHLY_AUDIO_MINUTES=60
FREE_TTS_MAX_COURSE_CHARACTERS=12000
PAID_TTS_MAX_AUTO_CHARACTERS=120000

# TTS playback/storage metadata. Use local for development or r2/s3/minio for object storage.
# Set TTS_STORAGE_BACKEND=r2 when generated audio should be uploaded to Cloudflare R2.
TTS_STORAGE_BACKEND=r2
TTS_SIGNED_URL_TTL_SECONDS=1800

# R2相关配置
S3_ENDPOINT_URL=http://localhost:19000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=web-reader-dev

# URL-imported article images. Leave storage backend empty to follow TTS_STORAGE_BACKEND.
# Set URL_IMPORT_IMAGE_STORAGE_BACKEND=r2 when imported article images should use Cloudflare R2.
URL_IMPORT_IMAGE_STORAGE_BACKEND=r2
URL_IMPORT_IMAGE_MAX_COUNT=20
URL_IMPORT_IMAGE_MAX_BYTES=8388608

# Worker direct API CLI execution. Defaults are usually correct; override only for custom deploy layouts.
# API_CLI_WORKDIR=/absolute/path/to/services/api
# API_CLI_PYTHON=/absolute/path/to/services/api/.venv/bin/python
